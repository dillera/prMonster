{
  "name": "fujinet-pr-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent harness that triages open pull requests on FujiNetWIFI/fujinet-firmware. See DESIGN.md.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/server/server/index.js",
    "scan": "tsx src/server/cli.ts scan",
    "eval": "tsx src/server/cli.ts eval",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@typesafe-ai/sdk": "0.6.0",
    "dotenv": "^18.0.1",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
