# Copy to .env (git-ignored) and fill in. Loaded by the server with dotenv.

# TypeSafe AI key for Jev (System One). Required for real evaluations.
# If this is missing and JEV_MOCK is not 1, the server still starts, the UI
# shows a "Jev key missing — running in mock mode" banner, and evaluations use
# the deterministic mock answers in src/server/mock.ts. Never crash on a
# missing key.
TYPESAFE_API_KEY=

# GitHub REST v3 token. Optional: falls back to `gh auth token` (spawned once
# at startup), then to unauthenticated requests (60 req/hr — the server warns).
GITHUB_TOKEN=

# Repository to triage, as owner/name.
GITHUB_REPO=FujiNetWIFI/fujinet-firmware

# Jev model id sent with every System One request.
JEV_MODEL=jev-latest

# 1 = never call Jev; always use src/server/mock.ts. 0 = call the real API
# whenever TYPESAFE_API_KEY is set.
JEV_MOCK=0

# Port for the Hono server. The Vite dev server (:5173) proxies /api here.
PORT=8787

# 1 = a human-confirmed action in the UI may actually POST to GitHub.
# 0 (default) = every confirmed action is recorded in the audit log with
# outcome "refused_writes_disabled" and nothing is written to GitHub.
# Merging is never an offered action.
ALLOW_GITHUB_WRITES=0
